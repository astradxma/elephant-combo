@*
   Blazor host for <elephant-combo>. Small state (config, selection, the selected
   ids' labels) goes down as attributes, so a prerendered page already shows the
   right trigger and Blazor's own diffing carries every change. Options can run
   to thousands of rows, so they go once per new list over JS interop instead —
   pass a new list instance to change them. Commits come back as OnChange.

   Load the element at page level too (<script type="module" src="…/elephant-combo.js">)
   so it upgrades during prerender, before the circuit exists.
*@
@namespace Elephant.Combo
@using System.Text.Json
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<elephant-combo @ref="_el" tabindex="0" @attributes="Attributes"
                config="@Json(Config)" selection="@Json(Selection ?? ComboSelection.Empty)"
                labels="@Json(SelectedLabels())"></elephant-combo>

@code {
    [Parameter] public IReadOnlyList<ComboOption> Options { get; set; } = [];
    [Parameter] public ComboSelection? Selection { get; set; }
    [Parameter] public ComboConfig Config { get; set; } = ComboConfig.Single;
    /// <summary>Display for selected ids that are not among <c>Options</c> (a custom value, a search result).</summary>
    [Parameter] public IReadOnlyDictionary<string, ComboItem>? Labels { get; set; }
    [Parameter] public EventCallback<ComboChange> OnChange { get; set; }
    [Parameter] public string ScriptPath { get; set; } = "./js/elephant-combo.js";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Attributes { get; set; }

    private static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);
    private static string Json(object o) => JsonSerializer.Serialize(o, JsonOpts);

    private ElementReference _el;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ElephantCombo>? _self;
    private IReadOnlyList<ComboOption>? _sentOptions;
    private IReadOnlyList<ComboOption>? _indexed;
    private Dictionary<string, ComboOption> _byId = new(StringComparer.Ordinal);

    // Labels for the selected ids only — the trigger needs nothing else.
    private Dictionary<string, ComboItem> SelectedLabels()
    {
        if (!ReferenceEquals(_indexed, Options))
        {
            _byId = new(StringComparer.Ordinal);
            foreach (var o in Options) _byId.TryAdd(o.Id, o);
            _indexed = Options;
        }
        var sel = Selection ?? ComboSelection.Empty;
        var labels = new Dictionary<string, ComboItem>(StringComparer.Ordinal);
        foreach (var id in sel.Include.Concat(sel.Exclude))
        {
            if (_byId.TryGetValue(id, out var o)) labels[id] = new(o.Label, o.Description, o.Href);
            else if (Labels?.TryGetValue(id, out var l) == true) labels[id] = l;
        }
        return labels;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && ReferenceEquals(_sentOptions, Options)) return;
        try
        {
            if (firstRender)
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", ScriptPath);
                _self = DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("mount", _el, _self, new { options = Options });
            }
            else if (_module is not null)
            {
                await _module.InvokeVoidAsync("update", _el, new { options = Options });
            }
            _sentOptions = Options;
        }
        catch (JSDisconnectedException) { /* circuit gone */ }
    }

    [JSInvokable]
    public Task OnComboChange(ComboChange change) => OnChange.InvokeAsync(change);

    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* circuit gone */ }
        }
    }
}
